context AuthContext {
    @jwt role: String?
    @jwt("customer_id") customerId: Int?
}

@postgres(schema = "commerce")
module Commerce {
    @access(query = AuthContext.role == "customer" && self.customerId == AuthContext.customerId, mutation = false)
    type Customer {
        @pk customerId: Int
        customerName: String
        orders: Set<Order>?
    }

    @access(
        query = (AuthContext.role == "customer" && self.customer.customerId == AuthContext.customerId)
            || AuthContext.role == "internal_staff_report",
        mutation = false
    )
    type Order {
        @pk orderId: Int
        @column("customer_id") customer: Customer
        orderedAt: Instant
        orderStatus: String
        orderItems: Set<OrderItem>?
    }

    @access(
        query = (AuthContext.role == "customer" && self.order.customer.customerId == AuthContext.customerId)
            || AuthContext.role == "internal_staff_report",
        mutation = false
    )
    type OrderItem {
        @pk orderItemId: Int
        @unique("order_line") @column("order_id") order: Order
        @unique("order_line") lineNo: Int
        @column("sku") product: Product
        quantity: Int
        unitPriceCents: Int
    }

    @access(
        query = (AuthContext.role == "customer" && AuthContext.customerId > 0)
            || AuthContext.role == "internal_staff_report",
        mutation = false
    )
    type Product {
        @pk sku: String
        productName: String
        category: String
        orderItems: Set<OrderItem>?
    }
}

@deno("staff_report.ts")
module StaffReporting {
    @access(AuthContext.role == "staff")
    type CategorySales {
        category: String
        revenueCents: Int
    }

    @access(AuthContext.role == "staff")
    export query staffSalesReport(startDate: String, endDate: String, limit: Int, @inject exograph: ExographPriv): Set<CategorySales>
}
