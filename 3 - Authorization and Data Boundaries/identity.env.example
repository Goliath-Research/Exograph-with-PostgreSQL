# Copy these settings into the local server process environment. Never commit real values.
EXO_SERVER_HOST=127.0.0.1
EXO_POSTGRES_READ_WRITE=false
EXO_POSTGRES_URL=postgres://exograph_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/exograph_commerce
EXO_JWT_SECRET=REPLACE_WITH_RANDOM_LAB_ONLY_SECRET
# Send short-lived lab tokens via Authorization: Bearer <token>.
# Ada: role=customer, customer_id=1; Lin: role=customer, customer_id=2.
# Staff: role=staff, no customer_id (authorizes staffSalesReport in src/staff_report.ts).
