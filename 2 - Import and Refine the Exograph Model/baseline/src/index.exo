@postgres(schema="commerce")
module CommerceDatabase {
  @access(query=false, mutation=false)
  type Customer {
    @pk customerId: Int
    customerName: String
    orders: Set<Order>?
  }

  @access(query=false, mutation=false)
  type Order {
    @pk orderId: Int
    @column("customer_id") customer: Customer
    orderedAt: Instant
    orderStatus: String
    orderItems: Set<OrderItem>?
  }

  @access(query=false, mutation=false)
  type OrderItem {
    @pk orderItemId: Int
    @unique("order_line") @column("order_id") order: Order
    @unique("order_line") lineNo: Int
    @column("sku") product: Product
    quantity: Int
    unitPriceCents: Int
  }

  @access(query=false, mutation=false)
  type Product {
    @pk sku: String
    productName: String
    category: String
    orderItems: Set<OrderItem>?
  }
}
